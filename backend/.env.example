PORT=4000
# Reemplaza con tu cadena de conexión de MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/NexusCode?retryWrites=true&w=majority
TOKEN_SECRET=TOKEN_SECRETO

# Cloudinary (para subir videos de ejercicios a la librería)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
